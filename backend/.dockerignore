# Docker ignore file for backend

# Build outputs
target/
build/

# IDE files
.idea/
*.iml
.vscode/

# Git
.git/
.gitignore

# Environment files (should use runtime injection)
.env
.env.*
*.env

# Documentation
docs/
*.md
!README.md

# Test files
src/test/

# Maven wrapper cache
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar.md5

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file (commit this if you want consistent provider versions)
# .terraform.lock.hcl

# Terraform directories
.terraform/

# SSH keys
*.pem
*.key

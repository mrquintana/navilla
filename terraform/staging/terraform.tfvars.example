# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

aws_region    = "us-east-1"
instance_type = "t3.micro"  # or t3.small if micro is too small

# SSH key pair name (must exist in AWS)
key_name = "your-key-pair-name"

# Restrict SSH access to your IP (recommended)
ssh_allowed_cidr = ["YOUR.IP.ADDRESS/32"]

# Domain name (optional - leave empty to use IP address)
domain_name = ""  # e.g., "staging.navilla.app"

# GitHub username for GHCR
ghcr_username = "your-github-username"

# Supabase configuration
supabase_url         = "https://your-project.supabase.co"
supabase_project_ref = "your-project-ref"  # The subdomain part of your Supabase URL
supabase_pooler_host = "aws-0-us-west-2.pooler.supabase.com"  # From Supabase Dashboard → Settings → Database → Connection pooler
supabase_anon_key    = "your-supabase-anon-key"
supabase_db_password = "your-supabase-db-password"  # From Supabase Dashboard → Settings → Database

# Encryption pepper (generate a random string)
encryption_pepper = "your-random-pepper-string"

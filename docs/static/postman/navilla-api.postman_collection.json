{
  "info": {
    "name": "Navilla API",
    "description": "API collection for Navilla - Privacy-preserving sexual health platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Public Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Public health check endpoint - no authentication required"
          }
        },
        {
          "name": "Authenticated Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "health"]
            },
            "description": "Authenticated health check - requires valid JWT token"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Get the current authenticated user's profile. Creates the user if they don't exist (lazy sync)."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"My Display Name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Update the current user's profile"
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Delete the current user's account"
          }
        }
      ]
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "Create Connection Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"recipient@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/connections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections"]
            },
            "description": "Create a new connection request to another user by their email"
          }
        },
        {
          "name": "Get All Connections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections"]
            },
            "description": "Get all connections for the current user (all statuses)"
          }
        },
        {
          "name": "Get Confirmed Connections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/confirmed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", "confirmed"]
            },
            "description": "Get only confirmed connections for the current user"
          }
        },
        {
          "name": "Get Pending Incoming Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/pending/incoming",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", "pending", "incoming"]
            },
            "description": "Get pending connection requests received by the current user"
          }
        },
        {
          "name": "Get Pending Sent Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/pending/sent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", "pending", "sent"]
            },
            "description": "Get pending connection requests sent by the current user"
          }
        },
        {
          "name": "Get Connection Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", "stats"]
            },
            "description": "Get connection statistics (confirmed count, pending incoming, pending sent)"
          }
        },
        {
          "name": "Accept Connection Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/:connectionId/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", ":connectionId", "accept"],
              "variable": [
                {
                  "key": "connectionId",
                  "value": "",
                  "description": "UUID of the connection to accept"
                }
              ]
            },
            "description": "Accept a pending connection request (recipient only)"
          }
        },
        {
          "name": "Deny Connection Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/:connectionId/deny",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", ":connectionId", "deny"],
              "variable": [
                {
                  "key": "connectionId",
                  "value": "",
                  "description": "UUID of the connection to deny"
                }
              ]
            },
            "description": "Deny a pending connection request (recipient only)"
          }
        },
        {
          "name": "Cancel Connection Request",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/connections/:connectionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "connections", ":connectionId"],
              "variable": [
                {
                  "key": "connectionId",
                  "value": "",
                  "description": "UUID of the connection to cancel"
                }
              ]
            },
            "description": "Cancel a pending connection request (requester only)"
          }
        }
      ]
    }
  ]
}

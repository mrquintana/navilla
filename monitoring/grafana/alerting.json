{
  "title": "Navilla — Alerting & Thresholds",
  "tags": [
    "navilla",
    "alerting",
    "thresholds"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Threshold Breaches",
        "datasource": "-- Grafana --",
        "enable": true,
        "iconColor": "red"
      }
    ]
  },
  "panels": [
    {
      "title": "— Availability & Errors —",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Error Rate (5xx %)",
      "description": "Alert if > 5% of requests are 5xx. Current value shown with threshold lines.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "rgba(255, 0, 0, 0.1)",
                "value": 0.05
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\"}[5m]))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "title": "5xx Count (last 15m)",
      "description": "Raw count of server errors in the last 15 minutes",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"navilla-backend\", status=~\"5..\"}[15m]))",
          "legendFormat": "5xx (15m)"
        }
      ]
    },
    {
      "title": "Zero Traffic Alert",
      "description": "Drops to 0 indicate the service may be down",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "green",
                "value": 0.1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\"}[5m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "title": "— Latency —",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false
    },
    {
      "title": "p95 Latency with SLO line",
      "description": "Alert if p95 exceeds 2s SLO",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"navilla-backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "Slowest Endpoints (p95)",
      "description": "Top endpoints by latency",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"navilla-backend\"}[5m])) by (le, uri)))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "title": "— Resource Saturation —",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false
    },
    {
      "title": "Heap Usage with Threshold",
      "description": "Alert if heap usage exceeds 90%",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "fixedColor": "purple",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "rgba(255, 0, 0, 0.1)",
                "value": 0.9
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", application=\"navilla-backend\"}) / sum(jvm_memory_max_bytes{area=\"heap\", application=\"navilla-backend\"})",
          "legendFormat": "Heap %"
        }
      ]
    },
    {
      "title": "CPU Usage with Threshold",
      "description": "Alert if process CPU exceeds 90%",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"navilla-backend\"}",
          "legendFormat": "Process CPU"
        }
      ]
    },
    {
      "title": "DB Pool Saturation",
      "description": "Alert if pool usage exceeds 85% or pending > 0",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "rgba(255, 0, 0, 0.1)",
                "value": 0.85
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"navilla-backend\"} / hikaricp_connections_max{application=\"navilla-backend\"}",
          "legendFormat": "Pool Usage %"
        }
      ]
    },
    {
      "title": "— Business Health —",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "collapsed": false
    },
    {
      "title": "Exposure Cache Hit Ratio",
      "description": "Alert if cache hit ratio drops below 50%",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(navilla_exposure_snapshot_total{cache=\"hit\", application=\"navilla-backend\"}[30m])) / sum(rate(navilla_exposure_snapshot_total{application=\"navilla-backend\"}[30m]))",
          "legendFormat": "Hit Ratio"
        }
      ]
    },
    {
      "title": "Exposure Computation Time",
      "description": "Alert if avg computation exceeds 1s",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "fixedColor": "purple",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(navilla_exposure_computation_duration_seconds_sum{application=\"navilla-backend\"}[5m]) / rate(navilla_exposure_computation_duration_seconds_count{application=\"navilla-backend\"}[5m])",
          "legendFormat": "Avg Duration"
        }
      ]
    },
    {
      "title": "Notification Failures",
      "description": "Alert on any notification creation failures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(navilla_notification_creation_failed_total{application=\"navilla-backend\"}[5m])",
          "legendFormat": "Failed ({{type}})"
        }
      ]
    },
    {
      "title": "— Alert Summary —",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false
    },
    {
      "title": "Threshold Reference",
      "type": "text",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "options": {
        "mode": "markdown",
        "content": "## Alert Thresholds\n\n| Metric | Warning | Critical | Window |\n|--------|---------|----------|--------|\n| Error Rate (5xx) | — | > 5% | 5m |\n| p95 Latency | — | > 2s | 5m |\n| Heap Usage | 70% | 90% | instant |\n| CPU Usage | — | 90% | instant |\n| DB Pool Usage | 60% | 85% | instant |\n| Cache Hit Ratio | — | < 50% | 30m |\n| Exposure Computation | — | > 1s | 5m |\n| Notification Failures | — | > 0 | 5m |\n| Zero Traffic | < 0.1 req/s | 0 req/s | 5m |\n\n*Configure actual Grafana alert rules via Alerting → Alert Rules → New Alert Rule using these PromQL expressions.*"
      }
    }
  ],
  "id": null,
  "uid": null,
  "schemaVersion": 39
}

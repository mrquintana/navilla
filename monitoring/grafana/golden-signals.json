{
  "dashboard": {
    "title": "Navilla — Golden Signals (SLA Overview)",
    "tags": ["navilla", "sla", "golden-signals", "overview"],
    "timezone": "browser",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "title": "— Traffic —",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "title": "Request Rate",
        "description": "Total HTTP requests per second",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "blue", "value": null }
              ]
            }
          }
        },
        "options": { "graphMode": "area" },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\"}[5m]))",
            "legendFormat": "req/s"
          }
        ]
      },
      {
        "title": "Request Rate by Endpoint",
        "description": "Traffic distribution across endpoints",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 18, "x": 6, "y": 1 },
        "fieldConfig": {
          "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
        },
        "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\"}[5m])) by (uri)",
            "legendFormat": "{{uri}}"
          }
        ]
      },
      {
        "title": "— Latency —",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
        "collapsed": false
      },
      {
        "title": "p50 Latency",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s", "decimals": 3,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "red", "value": 1.0 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"navilla-backend\"}[5m])) by (le))",
            "legendFormat": "p50"
          }
        ]
      },
      {
        "title": "p95 Latency",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 4, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s", "decimals": 3,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1.0 },
                { "color": "red", "value": 2.0 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"navilla-backend\"}[5m])) by (le))",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "title": "p99 Latency",
        "type": "stat",
        "gridPos": { "h": 6, "w": 4, "x": 8, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s", "decimals": 3,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 2.0 },
                { "color": "red", "value": 5.0 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"navilla-backend\"}[5m])) by (le))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "title": "Latency by Endpoint (p95)",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
        "fieldConfig": {
          "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
        },
        "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"navilla-backend\"}[5m])) by (le, uri))",
            "legendFormat": "{{uri}}"
          }
        ]
      },
      {
        "title": "— Errors —",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
        "collapsed": false
      },
      {
        "title": "Error Rate %",
        "description": "Percentage of requests returning 5xx",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit", "min": 0, "max": 1, "decimals": 2,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.05 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\"}[5m]))",
            "legendFormat": "Error %"
          }
        ]
      },
      {
        "title": "5xx Errors/sec",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 15 },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps", "decimals": 2,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "red", "value": 1 }
              ]
            }
          }
        },
        "options": { "graphMode": "area" },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\", status=~\"5..\"}[5m]))",
            "legendFormat": "5xx/s"
          }
        ]
      },
      {
        "title": "Errors by Status & Endpoint",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 15 },
        "fieldConfig": {
          "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
        },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"navilla-backend\", status=~\"[45]..\"}[5m])) by (status, uri)",
            "legendFormat": "{{status}} {{uri}}"
          }
        ]
      },
      {
        "title": "— Saturation —",
        "type": "row",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
        "collapsed": false
      },
      {
        "title": "Heap Usage %",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit", "min": 0, "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(jvm_memory_used_bytes{area=\"heap\", application=\"navilla-backend\"}) / sum(jvm_memory_max_bytes{area=\"heap\", application=\"navilla-backend\"})",
            "legendFormat": "Heap %"
          }
        ]
      },
      {
        "title": "CPU Usage",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 6, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit", "min": 0, "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "process_cpu_usage{application=\"navilla-backend\"}",
            "legendFormat": "Process CPU"
          }
        ]
      },
      {
        "title": "DB Pool Usage %",
        "description": "Active connections as percentage of max pool size",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 6, "x": 12, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit", "min": 0, "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.6 },
                { "color": "red", "value": 0.85 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "hikaricp_connections_active{application=\"navilla-backend\"} / hikaricp_connections_max{application=\"navilla-backend\"}",
            "legendFormat": "Pool Usage"
          }
        ]
      },
      {
        "title": "Pending DB Connections",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 18, "y": 22 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        "options": { "graphMode": "area" },
        "targets": [
          {
            "expr": "hikaricp_connections_pending{application=\"navilla-backend\"}",
            "legendFormat": "Pending"
          }
        ]
      },
      {
        "title": "Live Threads",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "blue", "value": null },
                { "color": "yellow", "value": 200 },
                { "color": "red", "value": 500 }
              ]
            }
          }
        },
        "options": { "graphMode": "area" },
        "targets": [
          {
            "expr": "jvm_threads_live_threads{application=\"navilla-backend\"}",
            "legendFormat": "Live Threads"
          }
        ]
      },
      {
        "title": "GC Pause Rate",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "unit": "s", "decimals": 4,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "red", "value": 0.5 }
              ]
            }
          }
        },
        "options": { "graphMode": "area" },
        "targets": [
          {
            "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"navilla-backend\"}[5m]))",
            "legendFormat": "GC time/s"
          }
        ]
      },
      {
        "title": "Exposure Cache Hit Ratio",
        "type": "gauge",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit", "min": 0, "max": 1,
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "green", "value": 0.8 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(rate(navilla_exposure_snapshot_total{cache=\"hit\", application=\"navilla-backend\"}[30m])) / sum(rate(navilla_exposure_snapshot_total{application=\"navilla-backend\"}[30m]))",
            "legendFormat": "Hit Ratio"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
